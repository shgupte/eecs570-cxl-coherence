diff --git a/src/cpu/testers/traffic_gen/csv_trace_gen.cc b/src/cpu/testers/traffic_gen/csv_trace_gen.cc
new file mode 100644
index 0000000000..195f5fcd0e
--- /dev/null
+++ b/src/cpu/testers/traffic_gen/csv_trace_gen.cc
@@ -0,0 +1,120 @@
+/*
+ * A lightweight CSV packet trace generator.
+ */
+
+#include "cpu/testers/traffic_gen/csv_trace_gen.hh"
+
+#include <algorithm>
+#include <sstream>
+
+#include "base/logging.hh"
+#include "base/trace.hh"
+#include "debug/TrafficGen.hh"
+#include "sim/cur_tick.hh"
+
+namespace gem5
+{
+
+CsvTraceGen::CsvTraceGen(
+    SimObject &obj, RequestorID requestor_id, Tick duration,
+    const std::string &trace_file, Addr addr_offset)
+    : BaseGen(obj, requestor_id, duration),
+      filename(trace_file),
+      addrOffset(addr_offset)
+{
+}
+
+bool
+CsvTraceGen::readElement(TraceElement &element)
+{
+    std::string line;
+    while (std::getline(trace, line)) {
+        if (line.empty() || line[0] == '#') {
+            continue;
+        }
+
+        std::replace(line.begin(), line.end(), ',', ' ');
+        std::istringstream input(line);
+        char operation;
+        Addr address;
+        unsigned size;
+        Tick tick;
+        if (!(input >> operation >> address >> size >> tick)) {
+            fatal("Malformed CSV trace line in %s: %s\n", filename, line);
+        }
+        if (operation != 'r' && operation != 'w') {
+            fatal("Unknown CSV trace operation '%c' in %s\n",
+                  operation, filename);
+        }
+        if (size == 0) {
+            fatal("Zero-sized CSV trace request in %s\n", filename);
+        }
+        if (!firstElement && tick < lastFileTick) {
+            fatal("CSV trace ticks are not monotonic in %s\n", filename);
+        }
+
+        element.cmd = operation == 'r' ? MemCmd::ReadReq : MemCmd::WriteReq;
+        element.addr = address;
+        element.size = size;
+        element.tick = tick;
+        lastFileTick = tick;
+        firstElement = false;
+        return true;
+    }
+    return false;
+}
+
+void
+CsvTraceGen::enter()
+{
+    if (trace.is_open()) {
+        trace.close();
+    }
+    trace.clear();
+    trace.open(filename);
+    if (!trace.is_open()) {
+        fatal("Unable to open CSV packet trace %s\n", filename);
+    }
+
+    tickOffset = curTick();
+    lastFileTick = 0;
+    firstElement = true;
+    hasNext = readElement(nextElement);
+}
+
+PacketPtr
+CsvTraceGen::getNextPacket()
+{
+    panic_if(!hasNext, "CSV trace %s has no next packet\n", filename);
+    const TraceElement current = nextElement;
+    hasNext = readElement(nextElement);
+
+    DPRINTF(TrafficGen, "CsvTraceGen: %s %#x size %u tick %llu\n",
+            current.cmd.isRead() ? "read" : "write",
+            current.addr + addrOffset, current.size, current.tick);
+    return getPacket(
+        current.addr + addrOffset, current.size, current.cmd);
+}
+
+Tick
+CsvTraceGen::nextPacketTick(bool elastic, Tick delay) const
+{
+    if (!hasNext) {
+        return MaxTick;
+    }
+    if (elastic) {
+        tickOffset += delay;
+    }
+    return std::max(tickOffset + nextElement.tick, curTick());
+}
+
+void
+CsvTraceGen::exit()
+{
+    if (hasNext) {
+        warn("CSV trace player %s did not replay the entire trace\n", name());
+    }
+    trace.close();
+}
+
+} // namespace gem5
