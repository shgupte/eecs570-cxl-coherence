@@ -0,0 +1,51 @@
+/*
+ * A lightweight CSV packet trace generator.
+ */
+
+#ifndef __CPU_TRAFFIC_GEN_CSV_TRACE_GEN_HH__
+#define __CPU_TRAFFIC_GEN_CSV_TRACE_GEN_HH__
+
+#include <fstream>
+#include <string>
+
+#include "base_gen.hh"
+#include "mem/packet.hh"
+
+namespace gem5
+{
+
+class CsvTraceGen : public BaseGen
+{
+  private:
+    struct TraceElement
+    {
+        MemCmd cmd = MemCmd::InvalidCmd;
+        Addr addr = 0;
+        unsigned size = 0;
+        Tick tick = 0;
+    };
+
+    bool readElement(TraceElement &element);
+
+    const std::string filename;
+    const Addr addrOffset;
+    std::ifstream trace;
+    TraceElement nextElement;
+    bool hasNext = false;
+    mutable Tick tickOffset = 0;
+    Tick lastFileTick = 0;
+    bool firstElement = true;
+
+  public:
+    CsvTraceGen(SimObject &obj, RequestorID requestor_id, Tick duration,
+                const std::string &trace_file, Addr addr_offset);
+
+    void enter() override;
+    PacketPtr getNextPacket() override;
+    void exit() override;
+    Tick nextPacketTick(bool elastic, Tick delay) const override;
+};
+
+} // namespace gem5
+
+#endif // __CPU_TRAFFIC_GEN_CSV_TRACE_GEN_HH__
